local function CreateSelectionBtn(parent, list, configKey, yStart, labelObj)
    local xOffset = 0
    for _, val in ipairs(list) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 65, 0, 25)
        btn.Position = UDim2.new(0, xOffset, 0, yStart)
        btn.Text = val
        btn.TextScaled = true
        btn.BackgroundColor3 = (Config[configKey] == val) and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(45, 45, 45)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.BorderSizePixel = 0
        btn.Parent = parent
        
        btn.Activated:Connect(function() 
            Config[configKey] = val
            -- Refresh all buttons in this row (simple way)
            for _, b in pairs(parent:GetChildren()) do
                if b:IsA("TextButton") and b.Position.Y.Offset == yStart then
                    local isMatch = (b.Text == Config[configKey])
                    b.BackgroundColor3 = isMatch and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(45, 45, 45)
                end
            end
        end)
        xOffset = xOffset + 70
    end
end

