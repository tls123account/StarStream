-- Utility
local function GetSafeClients()
    local w = workspace:FindFirstChild("Worlds")
    local t = w and w:FindFirstChild("Targets")
    return t and t:FindFirstChild("Clients")
end

local function UpdateList()
    for _, v in pairs(ScrollingFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    
    local yOffset = 0
    local btnHeight = 30
    local padding = 5
    
    local function CreateMobBtn(name, displayName)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -15, 0, btnHeight)
        btn.Position = UDim2.new(0, 5, 0, yOffset)
        btn.Text = displayName or name
        btn.TextScaled = true
        btn.BackgroundColor3 = (Config.SelectedMob == name) and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(35, 35, 35)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.SourceSans
        btn.BorderSizePixel = 0
        btn.Parent = ScrollingFrame
        
        btn.Activated:Connect(function()
            Config.SelectedMob = name
            UpdateList()
        end)
        
        yOffset = yOffset + btnHeight + padding
    end

    CreateMobBtn("All", "Tum Hedefler (All)")
    CreateMobBtn("All Raids", "Sadece Raidler (All Raids)")
    
    local clients = GetSafeClients()
    if clients then
        local added = {}
        for _, npc in ipairs(clients:GetChildren()) do
            if not added[npc.Name] then
                added[npc.Name] = true
                
                local dName = npc.Name
                if string.match(dName, "^Raids") then
                    dName = "Raid: " .. string.sub(dName, 6, 15) .. "..."
                end
                
                CreateMobBtn(npc.Name, dName)
            end
        end
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Mobile & PC Attack (Simulate Tool Use)
local function Attack()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate() -- Mobile-friendly tool use
    end
end

ToggleBtn.Activated:Connect(function()
    Config.Enabled = not Config.Enabled
    ToggleBtn.Text = "Farm: " .. (Config.Enabled and "ON" or "OFF")
    ToggleBtn.BackgroundColor3 = Config.Enabled and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(180, 50, 50)
end)

-- Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if not Config.Enabled then continue end
        
        local clients = GetSafeClients()
        if not clients then continue end

        local targets = clients:GetChildren()
        for _, target in ipairs(targets) do
            if not Config.Enabled then break end
            
            local isRaid = string.match(target.Name, "^Raids")
            if Config.SelectedMob == "All Raids" then
                if not isRaid then continue end
            elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                continue 
            end

            local torso = target:FindFirstChild("Torso")
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            -- Cycle through: find first alive
            if torso and hrp and torso.Transparency < 0.9 then
                -- Stay until death (transparency 1)
                while torso and torso.Parent and torso.Transparency < 0.9 and Config.Enabled do
                    
                    local currentIsRaid = string.match(target.Name, "^Raids")
                    if Config.SelectedMob == "All Raids" then
                        if not currentIsRaid then break end
                    elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                        break 
                    end
                    
                    hrp.Velocity = Vector3.new(0,0,0)
                    hrp.CFrame = torso.CFrame * CFrame.new(0, 0, Config.Distance)
                    Attack()
                    task.wait()
                end
                task.wait(0.1)
            end
        end
    end
end)

