-- Functions
local function Attack()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate()
    end
end

-- Broader search function
local function GetRaidNPCs()
    local list = {}
    
    -- Method 1: Standard path
    local worlds = workspace:FindFirstChild("Worlds")
    local targets = worlds and worlds:FindFirstChild("Targets")
    local clients = targets and targets:FindFirstChild("Clients")
    
    if clients then
        for _, npc in ipairs(clients:GetChildren()) do
            -- Broader name match: "raid" instead of "raids", case-insensitive
            if string.find(string.lower(npc.Name), "raid") then
                table.insert(list, npc)
            end
        end
    end
    
    -- Method 2: Fallback - Search ALL models in workspace if Method 1 found nothing
    if #list == 0 then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and string.find(string.lower(v.Name), "raid") then
                -- Basic check to avoid targeting player
                if not game.Players:GetPlayerFromCharacter(v) then
                    table.insert(list, v)
                end
            end
            -- Limit to avoid hanging on massive games
            if #list >= 10 then break end
        end
    end
    
    return list
end

-- Toggle Logic
ToggleBtn.Activated:Connect(function()
    Config.Enabled = not Config.Enabled
    ToggleBtn.Text = Config.Enabled and "STOP RAID FARM" or "START RAID FARM"
    ToggleBtn.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    UIStroke.Color = Config.Enabled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(150, 50, 255)
    
    if not Config.Enabled then
        StatusLabel.Text = "Status: Stopped"
        TargetLabel.Text = "Target: None"
    end
end)

-- Main Loop
task.spawn(function()
    while true do
        task.wait(0.5)
        if not Config.Enabled then continue end
        
        StatusLabel.Text = "Status: Searching..."
        local targets = GetRaidNPCs()
        
        if #targets == 0 then
            StatusLabel.Text = "Status: No 'Raid' NPC found"
            continue
        end
        
        StatusLabel.Text = "Status: Found " .. #targets .. " NPCs"
        
        for _, npc in ipairs(targets) do
            if not Config.Enabled then break end
            
            -- Keep targeting until deleted
            TargetLabel.Text = "Target: " .. npc.Name
            
            while npc and npc.Parent and Config.Enabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then break end
                
                -- Target Head/Torso
                local targetPart = npc:FindFirstChild("Head") or npc:FindFirstChild("Torso") or npc:FindFirstChildWhichIsA("BasePart")
                if not targetPart then break end
                
                -- Direct TP
                hrp.Velocity = Vector3.new(0,0,0)
                hrp.CFrame = targetPart.CFrame
                
                Attack()
                task.wait() -- High frequency
            end
            
            TargetLabel.Text = "Target: Switching..."
        end
    end
end)

print("Raid Expert v1.1 Loaded!")
