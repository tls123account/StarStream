-- Effects Cleaner: INSTANT Removal
local function ClearVisual()
    local visual = workspace:FindFirstChild("Visual")
    if visual then
        for _, child in pairs(visual:GetChildren()) do
            if child.Name ~= "Player" then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

-- Listen for new items instantly
task.spawn(function()
    local visual = workspace:WaitForChild("Visual")
    visual.ChildAdded:Connect(function(child)
        if Config.RemoveEffects and child.Name ~= "Player" then
            task.wait() -- Small wait to ensure it exists before destroying (prevents some engine crashes)
            pcall(function() child:Destroy() end)
        end
    end)
    
    -- Periodic backup clear just in case
    while task.wait(2) do
        if Config.RemoveEffects then
            ClearVisual()
        end
    end
end)

-- Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if not Config.Enabled then continue end
        
        local clients = GetSafeClients()
        if not clients then continue end

        local targets = clients:GetChildren()
        for _, target in ipairs(targets) do
            if not Config.Enabled then break end
            
            local isRaid = string.match(target.Name, "^Raids")
            if Config.SelectedMob == "All Raids" then
                if not isRaid then continue end
            elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                continue 
            end

            local torso = target:FindFirstChild("Torso")
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            -- Cycle through: find first alive
            if torso and hrp and torso.Transparency < 0.9 then
                -- Stay until death
                while target and target.Parent and Config.Enabled do
                    local isRaid = string.match(target.Name, "^Raids")
                    local currentTorso = target:FindFirstChild("Torso")

                    -- If NOT a raid, check transparency. If IS a raid, don't check transparency.
                    if not isRaid then
                        if not currentTorso or currentTorso.Transparency >= 0.9 then
                            break
                        end
                    end
                    
                    if not currentTorso then break end
                    
                    local currentIsRaid = string.match(target.Name, "^Raids")
                    if Config.SelectedMob == "All Raids" then
                        if not currentIsRaid then break end
                    elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                        break 
                    end
                    
                    hrp.Velocity = Vector3.new(0,0,0)
                    hrp.CFrame = currentTorso.CFrame * CFrame.new(0, 0, Config.Distance)
                    Attack()
                    task.wait()
                end
                task.wait(0.1)
            end
        end
    end
end)

