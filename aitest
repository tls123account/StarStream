-- Effects Cleaner: INSTANT Removal
local function ClearVisual()
    local visual = workspace:FindFirstChild("Visual")
    if visual then
        for _, child in pairs(visual:GetChildren()) do
            if child.Name ~= "Player" then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

-- Listen for new items instantly
task.spawn(function()
    local visual = workspace:WaitForChild("Visual")
    visual.ChildAdded:Connect(function(child)
        if Config.RemoveEffects and child.Name ~= "Player" then
            task.wait() -- Small wait to ensure it exists before destroying (prevents some engine crashes)
            pcall(function() child:Destroy() end)
        end
    end)
    
    -- Periodic backup clear just in case
    while task.wait(2) do
        if Config.RemoveEffects then
            ClearVisual()
        end
        if Config.AutoCollectRewards then
            local raids_visual = workspace:FindFirstChild("Raids_Visual")
            if raids_visual then
                for _, server_folder in pairs(raids_visual:GetChildren()) do
                    if string.find(server_folder.Name, LocalPlayer.Name) then
                        pcall(function()
                            local rewards = server_folder:FindFirstChild("Configs") and server_folder.Configs:FindFirstChild("Others") and server_folder.Configs.Others:FindFirstChild("Rewards")
                            if rewards then
                                local special = rewards:FindFirstChild("Special") and rewards.Special:FindFirstChild("Primary") and rewards.Special.Primary:FindFirstChildOfClass("ProximityPrompt")
                                if special then fireproximityprompt(special) end
                                
                                local golds = rewards:FindFirstChild("Golds") and rewards.Golds:FindFirstChild("Primary") and rewards.Golds.Primary:FindFirstChildOfClass("ProximityPrompt")
                                if golds then fireproximityprompt(golds) end
                            end
                        end)
                    end
                end
            end
        end
    end
end)

-- Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if not Config.Enabled then continue end
        
        local clients = GetSafeClients()
        if not clients then continue end

        local targets = clients:GetChildren()
        for _, target in ipairs(targets) do
            if not Config.Enabled then break end
            
            local isRaid = string.find(string.lower(target.Name), "raid")
            if Config.SelectedMob == "All Raids" then
                if not isRaid then continue end
            elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                continue 
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- Get any valid part to TP to (Priority: Torso > Head > HRP > Any)
            local targetPart = target:FindFirstChild("Torso") or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
            
            -- Entry Check
            local canTarget = false
            if isRaid then
                canTarget = true -- Raids: Always target if model exists, ignore transparency
            elseif targetPart and targetPart.Transparency < 0.9 then
                canTarget = true -- Normal: Check transparency
            end

            if canTarget and targetPart then
                -- Stay until model is deleted or disabled
                while target and target.Parent and Config.Enabled do 
                    local isRaidNow = string.find(string.lower(target.Name), "raid")
                    local currentPart = target:FindFirstChild("Torso") or target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
                    
                    if not currentPart then break end
                    
                    -- Death check for NORMAL mobs only (Raids ignore this)
                    if not isRaidNow and currentPart.Transparency >= 0.9 then
                        break
                    end
                    
                    -- Selection check
                    if Config.SelectedMob == "All Raids" then
                        if not isRaidNow then break end
                    elseif Config.SelectedMob ~= "All" and target.Name ~= Config.SelectedMob then 
                        break 
                    end
                    
                    hrp.Velocity = Vector3.new(0,0,0)
                    hrp.CFrame = currentPart.CFrame * CFrame.new(0, 0, Config.Distance)
                    Attack() -- Keep attacking just in case
                    task.wait()
                end
                task.wait(0.1)
            end
        end
    end
end)

