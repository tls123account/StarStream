-- Remove UIListLayout and calculate positions manually to bypass Delta bugs
-- Utility
local function GetSafeClients()
    local w = workspace:FindFirstChild("Worlds")
    local t = w and w:FindFirstChild("Targets")
    return t and t:FindFirstChild("Clients")
end

local function UpdateList()
    for _, v in pairs(ScrollingFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    
    local yOffset = 0
    local btnHeight = 30
    local padding = 5
    
    local function CreateMobBtn(name, displayName)
        local btn = Instance.new("TextButton")
        -- Use strict pixel counts to avoid Delta scaling bugs
        btn.Size = UDim2.new(0, 260, 0, btnHeight)
        btn.Position = UDim2.new(0, 5, 0, yOffset)
        btn.Text = displayName or name
        btn.TextScaled = true
        btn.BackgroundColor3 = (Config.SelectedMob == name) and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(35, 35, 35)
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.SourceSans
        btn.BorderSizePixel = 0
        btn.Parent = ScrollingFrame
        
        btn.Activated:Connect(function()
            Config.SelectedMob = name
            UpdateList()
        end)
        
        yOffset = yOffset + btnHeight + padding
    end

    CreateMobBtn("All", "Tum Hedefler (All)")
    CreateMobBtn("All Raids", "Sadece Raidler (All Raids)")
    
    local clients = GetSafeClients()
    if clients then
        local added = {}
        for _, npc in ipairs(clients:GetChildren()) do
            if not added[npc.Name] then
                added[npc.Name] = true
                
                local dName = npc.Name
                local isRaid = string.find(string.lower(npc.Name), "raid")
                if isRaid then
                    dName = "Raid: " .. string.sub(dName, 1, 15) .. "..."
                end
                
                CreateMobBtn(npc.Name, dName)
            end
        end
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

