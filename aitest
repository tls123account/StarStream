-- RAID EXPERT FARM (SPECIALIZED)
-- Targets anything containing "Raids" in workspace.Worlds.Targets.Clients
-- Direct TP to Head/Torso with 0 offset. Instant cycle on model deletion.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- GUI Setup
local targetParent = pcall(function() return gethui and gethui() or game:GetService("CoreGui") end) and (gethui and gethui() or game:GetService("CoreGui")) or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

-- Clean old instances
for _, v in pairs(targetParent:GetChildren()) do
    if v.Name == "RaidExpertGui" then v:Destroy() end
end

local Config = {
    Enabled = false
}

-- Lightweight Premium GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RaidExpertGui"
ScreenGui.Parent = targetParent

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 220, 0, 100)
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -50)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner", MainFrame)
UICorner.CornerRadius = UDim.new(0, 10)

local UIStroke = Instance.new("UIStroke", MainFrame)
UIStroke.Color = Color3.fromRGB(150, 50, 255)
UIStroke.Thickness = 2
UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "RAID EXPERT v1.0"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16
Title.Parent = MainFrame

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 180, 0, 45)
ToggleBtn.Position = UDim2.new(0.5, -90, 0.5, -5)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
ToggleBtn.Text = "RAID FARM: OFF"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.TextSize = 18
ToggleBtn.BorderSizePixel = 0
ToggleBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner", ToggleBtn)
BtnCorner.CornerRadius = UDim.new(0, 8)

-- Functions
local function Attack()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate()
    end
end

local function GetRaidNPCs()
    local list = {}
    local worlds = workspace:FindFirstChild("Worlds")
    local targets = worlds and worlds:FindFirstChild("Targets")
    local clients = targets and targets:FindFirstChild("Clients")
    
    if clients then
        for _, npc in ipairs(clients:GetChildren()) do
            if string.find(string.lower(npc.Name), "raids") then
                table.insert(list, npc)
            end
        end
    end
    return list
end

-- Toggle Logic
ToggleBtn.Activated:Connect(function()
    Config.Enabled = not Config.Enabled
    ToggleBtn.Text = "RAID FARM: " .. (Config.Enabled and "ON" or "OFF")
    ToggleBtn.BackgroundColor3 = Config.Enabled and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    UIStroke.Color = Config.Enabled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(150, 50, 255)
end)

-- Main Loop
task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.Enabled then continue end
        
        local targets = GetRaidNPCs()
        if #targets == 0 then continue end
        
        for _, npc in ipairs(targets) do
            if not Config.Enabled then break end
            
            -- Targeted Loop
            while npc and npc.Parent and Config.Enabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then break end
                
                -- Priority: Head or Torso for maximum hit registration
                local targetPart = npc:FindFirstChild("Head") or npc:FindFirstChild("Torso") or npc:FindFirstChildWhichIsA("BasePart")
                if not targetPart then break end
                
                -- Direct TP
                hrp.Velocity = Vector3.zero
                hrp.CFrame = targetPart.CFrame
                
                Attack()
                task.wait() -- Fast as possible
            end
        end
    end
end)

print("Raid Expert Loaded! Targeting name: 'Raids'")
